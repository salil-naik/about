{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/starship", "destination": "/starship/index.html" },
    { "source": "/starship/", "destination": "/starship/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
